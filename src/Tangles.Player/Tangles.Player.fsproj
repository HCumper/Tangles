<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <RunAOTCompilation>false</RunAOTCompilation>
    <WasmBuildNative>false</WasmBuildNative>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Tangles.Core/Tangles.Core.fsproj" />
    <PackageReference Include="Bolero" Version="0.25.65" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="11.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="11.0.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.AspNetCore.Components" Version="11.0.0" />
    <PackageReference Include="Microsoft.JSInterop.WebAssembly" Version="11.0.0" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="Main.fs" />
    <Compile Include="Startup.fs" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="../../LICENSE" Link="wwwroot/LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../COPYRIGHT.txt" Link="wwwroot/COPYRIGHT.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../docs/releases/1.00.md"
             Link="wwwroot/release-notes.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../third-party/web/**/*"
             Link="wwwroot/third-party/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="../../puzzles/*-20261120.json;../../puzzles/ramp-*.json"
             Link="wwwroot/packs/%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
