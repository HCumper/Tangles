## Copy pack_ssb, json_ssb and starter_json to the mounted QL device.
## This application uses named game records, never JSON nodes or field lookups.
#INCLUDE pack_ssb
pack_load "nfa1_starter_json",4096
IF packDoc.error% THEN
  PRINT packDoc.message$;" at byte ";packDoc.errorPosition
  STOP
END IF
PRINT "Puzzles: ";packDoc.puzzleCount%
FOR examplePuzzle% = 1 TO packDoc.puzzleCount%
  PRINT packPuzzles(examplePuzzle%).id$
  PRINT packPuzzles(examplePuzzle%).width%;" by ";packPuzzles(examplePuzzle%).height%;", pairs: ";packPuzzles(examplePuzzle%).pairCount%
  FOR examplePair% = 0 TO packPuzzles(examplePuzzle%).pairCount%-1
    exampleSlot% = packPuzzles(examplePuzzle%).firstPair%+examplePair%
    PRINT packPairs(exampleSlot%).label$;": ";packPairs(exampleSlot%).start.x%;",";packPairs(exampleSlot%).start.y%;" -> ";packPairs(exampleSlot%).finish.x%;",";packPairs(exampleSlot%).finish.y%
  END FOR examplePair%
END FOR examplePuzzle%
pack_free
STOP
