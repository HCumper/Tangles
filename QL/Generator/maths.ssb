## Portable integer primitives. No host generation code is used.
DIM hashK(63),hashH(7),hashV(7),hashW(63),hashByte%(63),mixByte%(4,7)
hashAt%=0 : hashBytes=0
FOR mathI%=0 TO 32
  gPower(mathI%)=2^mathI%
END FOR mathI%
## SHA-256 round constants are stored as signed 32-bit values. Negative literals
## preserve the required bit patterns without unsigned floating-point rounding.
hashK(0)=1116352408
